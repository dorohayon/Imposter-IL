# Copy to the VM as /var/imposter/.env. docker compose reads it automatically,
# so a deploy only has to rewrite IMPOSTER_IMAGE.
IMPOSTER_DOMAIN=api.example.com
IMPOSTER_IMAGE=us-central1-docker.pkg.dev/PROJECT/imposter/server:latest

# Raise to retire old app builds once a new one is live in both stores.
# See docs/protocol.md; 0 accepts every client.
MIN_CLIENT_BUILD=0
STAGING_BOTS=0

# Monetization (docs/monetization.md). Empty keeps the built-in model: food,
# animals and places free, server enforcement off.
MONETIZATION_CONFIG=
# Store verification, needed before MONETIZATION_CONFIG turns on
# serverEnforcement (and MIN_CLIENT_BUILD must then be at least 4).
APPLE_BUNDLE_ID=
GOOGLE_PLAY_PACKAGE=
# The service account key file's JSON. A secret: keep this file 0600.
GOOGLE_PLAY_SERVICE_ACCOUNT=
