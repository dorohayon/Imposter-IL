  "saving": "Saving...",
  "acceptAndContinue": "Accept and continue",
  "legalGateHeadline": "Fair play starts with clear rules",
  "legalGateBody": "In this game you write nicknames and hints that other players can see. We filter inappropriate content and let you report and hide players.",
  "termsTitle": "Terms of Use",
